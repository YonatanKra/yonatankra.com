  { year:'2023', event:'Jfokus', date:'Feb 8, 2023', title:'GitHub Actions — From Zero to Hero', subtitle:'Jfokus · Stockholm', video:'e3xN6p5RB98', tags:['DevOps','CI/CD','GitHub Actions'] },
  { year:'2023', event:'ConfrontJS', date:'Mar 24, 2023', title:'Test Drive Your Code', subtitle:'ConfrontJS 2023 · Warsaw · Keynote', video:'zmjBc_jhRfA', tags:['Testing','Professionalism','JavaScript'] },
  { year:'2022', event:'ConfrontJS', title:'How to Optimize JavaScript Performance', subtitle:'ConfrontJS · Warsaw', video:'DsnxUcyo0-4', tags:['JavaScript','Performance'] },
