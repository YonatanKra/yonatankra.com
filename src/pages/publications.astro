  { year:'2024', event:'Jfokus', date:'Feb 2024', title:'Gaming Optimization Design Patterns You Should Apply to Your Web App', subtitle:'Jfokus · Stockholm', video:'udB8f37huYw', tags:['JavaScript','Performance','Design Patterns'] },
