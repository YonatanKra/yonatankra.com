---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const slugify = (tag) => tag.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = new Map();
  for (const post of posts) {
    for (const tag of post.data.tags) if (!tags.has(slugify(tag))) tags.set(slugify(tag), tag);
  }
  return [...tags].map(([slug, name]) => ({ params: { tag: slug }, props: { slug, name } }));
}

const { slug, name } = Astro.props;
const base = import.meta.env.BASE_URL;
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts
  .filter((post) => post.data.tags.some((tag) => slugify(tag) === slug))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title={`${name} | Yonatan Kra`} description={`Posts tagged ${name}`} canonical={new URL(`/tag/${slug}/`, Astro.site).href}>
  <section class="archive-shell">
    <div class="eyebrow">Tag</div>
    <h1>{name}</h1>
    <p class="archive-summary">{posts.length} article{posts.length === 1 ? '' : 's'} tagged with “{name}”.</p>
    <div class="archive-list">
      {posts.map((post) => (
        <article class="archive-card">
          <div>
            <time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            <h2><a href={`${base}${post.data.slug}/`}>{post.data.title}</a></h2>
            {(post.data.excerpt || post.data.description) && <p>{post.data.excerpt ?? post.data.description}</p>}
          </div>
          {post.data.featuredImage && <a class="archive-image" href={`${base}${post.data.slug}/`}><img src={post.data.featuredImage} alt="" /></a>}
        </article>
      ))}
    </div>
  </section>
  <style>
    .archive-shell { width: min(900px, calc(100% - 40px)); margin: 0 auto; padding: 48px 0 20px; }
    h1 { margin: 6px 0 4px; font-size: clamp(2.4rem,5vw,4rem); letter-spacing: -.055em; }
    .archive-summary { margin: 0 0 28px; color: var(--muted); }
    .archive-list { border-top: 1px solid var(--line); }
    .archive-card { display: grid; grid-template-columns: minmax(0,1fr) 180px; gap: 28px; padding: 24px 0; border-bottom: 1px solid var(--line); align-items: center; }
    .archive-card time { color: var(--muted); font-size: .76rem; }
    .archive-card h2 { margin: 5px 0 8px; font-size: 1.35rem; letter-spacing: -.03em; line-height: 1.25; }
    .archive-card p { margin: 0; color: #526175; font-size: .9rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .archive-image { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 9px; background: #eef2f7; }
    .archive-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
    @media (max-width: 650px) { .archive-card { grid-template-columns: 1fr; } .archive-image { order: -1; } }
  </style>
</BaseLayout>
