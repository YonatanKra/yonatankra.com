---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const pages = await getCollection('pages', ({ data }) => !data.draft);

  return [
    ...posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, kind: 'post' } })),
    ...pages.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, kind: 'page' } })),
  ];
}

const { entry, kind } = Astro.props;
const rendered = await render(entry);
const { Content } = rendered;
const headings = rendered.headings ?? [];
const description = entry.data.description ?? (kind === 'post' ? entry.data.excerpt : undefined) ?? '';
const canonical = entry.data.canonical ?? new URL(`/${entry.data.slug}/`, Astro.site).href;
const isPost = kind === 'post';
const categoryName = (category) => typeof category === 'string' ? category : category.name;
const categories = isPost ? entry.data.categories : [];
const displayDate = isPost && entry.data.published
  ? entry.data.published.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : '';
const shareUrl = encodeURIComponent(canonical);
---
<BaseLayout title={`${entry.data.title} | Yonatan Kra`} description={description} canonical={canonical}>
  {isPost ? (
    <article class="post-shell">
      <aside class="toc-panel">
        <div class="aside-label">In this article</div>
        <nav aria-label="Table of contents">
          {headings.filter((heading) => heading.depth <= 3).map((heading) => (
            <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </aside>

      <div class="post-main">
        <header class="post-header">
          {categories.length > 0 && (
            <div class="post-categories">{categories.slice(0, 4).map((category) => <span>{categoryName(category)}</span>)}</div>
          )}
          <h1>{entry.data.title}</h1>
          <div class="author-line">
            <div class="avatar">YK</div>
            <strong>{entry.data.author}</strong>
            <span>•</span>
            <time datetime={entry.data.published.toISOString()}>{displayDate}</time>
          </div>
          {entry.data.featuredImage && <img class="featured-image" src={entry.data.featuredImage} alt="" />}
        </header>
        <div class="article-content"><Content /></div>
        {entry.data.comments.length > 0 && (
          <section class="comments" aria-labelledby="comments-title">
            <h2 id="comments-title">Comments</h2>
            {entry.data.comments.map((comment) => (
              <article class="comment">
                <h3>{comment.author}</h3>
                <time datetime={comment.date.toISOString()}>{comment.date.toLocaleDateString()}</time>
                <div set:html={comment.content} />
              </article>
            ))}
          </section>
        )}
      </div>

      <aside class="article-info">
        <div class="aside-label">About this article</div>
        <div class="info-row">◷ <span>{displayDate}</span></div>
        {categories.length > 0 && <div class="info-chips">{categories.slice(0, 5).map((category) => <span class="chip">{categoryName(category)}</span>)}</div>}
        <hr />
        <div class="aside-label">Share</div>
        <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${encodeURIComponent(entry.data.title)}`}>Twitter / X</a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}>LinkedIn</a>
        <a href={`mailto:?subject=${encodeURIComponent(entry.data.title)}&body=${shareUrl}`}>Email</a>
      </aside>
    </article>
  ) : (
    <article class="simple-page">
      <h1>{entry.data.title}</h1>
      <div class="article-content"><Content /></div>
    </article>
  )}

  <style>
    .post-shell { width: min(1260px, calc(100% - 40px)); margin: 0 auto; padding: 42px 0 20px; display: grid; grid-template-columns: 190px minmax(0,760px) 180px; justify-content: center; gap: 48px; align-items: start; }
    .toc-panel, .article-info { position: sticky; top: 110px; color: #475569; font-size: .8rem; }
    .aside-label { margin-bottom: 14px; color: #1e293b; text-transform: uppercase; letter-spacing: .055em; font-size: .68rem; font-weight: 800; }
    .toc-panel nav { border-left: 1px solid var(--line); }
    .toc-panel a { display: block; margin-left: -1px; padding: 6px 0 6px 13px; border-left: 2px solid transparent; line-height: 1.35; }
    .toc-panel a:hover { border-left-color: var(--blue); color: var(--blue); }
    .toc-panel .depth-3 { padding-left: 24px; color: #64748b; }
    .post-main { min-width: 0; }
    .post-header { margin-bottom: 30px; }
    .post-categories { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; color: var(--blue); text-transform: uppercase; font-size: .72rem; font-weight: 800; letter-spacing: .035em; }
    .post-categories span + span::before { content: '•'; margin-right: 8px; color: #94a3b8; }
    .post-header h1 { margin: 0; font-size: clamp(2.3rem, 4.6vw, 4rem); line-height: 1.03; letter-spacing: -.055em; }
    .author-line { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 20px 0 22px; color: var(--muted); font-size: .82rem; }
    .author-line strong { color: #1e293b; }
    .avatar { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: #334155; font-size: .68rem; font-weight: 800; }
    .featured-image { display: block; width: 100%; max-height: 480px; object-fit: cover; margin: 0; border-radius: 12px; box-shadow: 0 5px 20px rgba(15,23,42,.06); }
    .article-content { color: #263244; font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif; font-size: 1.08rem; line-height: 1.82; }
    .article-content :global(h2), .article-content :global(h3), .article-content :global(h4) { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: var(--ink); letter-spacing: -.035em; scroll-margin-top: 100px; }
    .article-content :global(h2) { margin: 2.3em 0 .65em; font-size: 1.65rem; line-height: 1.2; }
    .article-content :global(h3) { margin: 1.9em 0 .55em; font-size: 1.3rem; line-height: 1.25; }
    .article-content :global(p) { margin: 0 0 1.35em; }
    .article-content :global(a) { color: #1657c8; text-decoration: underline; text-decoration-color: #bfdbfe; text-underline-offset: 3px; }
    .article-content :global(a:hover) { text-decoration-color: #1657c8; }
    .article-content :global(img) { display: block; max-width: 100%; height: auto; margin: 1.7rem auto; border-radius: 8px; }
    .article-content :global(figure) { margin: 1.8rem 0; }
    .article-content :global(figcaption) { color: var(--muted); font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: .78rem; text-align: center; }
    .article-content :global(ul), .article-content :global(ol) { padding-left: 1.4em; margin-bottom: 1.4em; }
    .article-content :global(li) { margin-bottom: .42em; }
    .article-content :global(pre) { margin: 1.8rem 0; font-family: "SFMono-Regular", Consolas, monospace; }
    .article-content :global(table) { width: 100%; border-collapse: collapse; display: block; overflow-x: auto; font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: .88rem; }
    .article-content :global(th), .article-content :global(td) { padding: 9px 12px; border: 1px solid var(--line); text-align: left; }
    .article-info { display: flex; flex-direction: column; gap: 11px; }
    .article-info hr { width: 100%; margin: 12px 0; border: 0; border-top: 1px solid var(--line); }
    .info-row { display: flex; gap: 8px; align-items: center; }
    .info-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0; }
    .article-info > a { color: #334155; }
    .article-info > a:hover { color: var(--blue); }
    .comments { margin-top: 54px; padding-top: 28px; border-top: 1px solid var(--line); }
    .comments h2 { font-size: 1.4rem; }
    .comment { margin: 20px 0; padding: 18px; border: 1px solid var(--line); border-radius: 10px; background: var(--soft); }
    .comment h3 { margin: 0; font-size: .95rem; }
    .comment time { color: var(--muted); font-size: .76rem; }
    .simple-page { width: min(760px, calc(100% - 40px)); margin: 0 auto; padding: 50px 0; }
    .simple-page h1 { font-size: clamp(2.2rem,5vw,3.6rem); letter-spacing: -.05em; }
    @media (max-width: 1100px) {
      .post-shell { grid-template-columns: 170px minmax(0,760px); gap: 34px; }
      .article-info { display: none; }
    }
    @media (max-width: 800px) {
      .post-shell { width: min(100% - 28px, 760px); display: block; padding-top: 28px; }
      .toc-panel { position: static; margin: 26px 0; padding: 16px; border: 1px solid var(--line); border-radius: 10px; background: #f8fafc; }
      .toc-panel nav { columns: 2; column-gap: 20px; border-left: 0; }
      .toc-panel a { border-left: 0; padding-left: 0; break-inside: avoid; }
      .post-header h1 { font-size: 2.55rem; }
    }
    @media (max-width: 520px) {
      .post-header h1 { font-size: 2.15rem; }
      .toc-panel nav { columns: 1; }
      .article-content { font-size: 1.02rem; line-height: 1.75; }
    }
  </style>
</BaseLayout>
