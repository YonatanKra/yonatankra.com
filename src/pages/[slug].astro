---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const pages = await getCollection('pages', ({ data }) => !data.draft);

  return [
    ...posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, kind: 'post' } })),
    ...pages.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, kind: 'page' } })),
  ];
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.description ?? (kind === 'post' ? entry.data.excerpt : undefined) ?? '';
const canonical = entry.data.canonical ?? new URL(`/${entry.data.slug}/`, Astro.site).href;
const isPost = kind === 'post';
---
<BaseLayout title={`${entry.data.title} | Yonatan Kra`} description={description} canonical={canonical}>
  <article>
    <h1>{entry.data.title}</h1>
    {isPost && entry.data.published && (
      <p><time datetime={entry.data.published.toISOString()}>{entry.data.published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></p>
    )}
    <Content />
    {isPost && entry.data.comments.length > 0 && (
      <section aria-labelledby="comments-title">
        <h2 id="comments-title">Comments</h2>
        {entry.data.comments.map((comment) => (
          <article>
            <h3>{comment.author}</h3>
            <time datetime={comment.date.toISOString()}>{comment.date.toLocaleDateString()}</time>
            <p set:html={comment.content} />
          </article>
        ))}
      </section>
    )}
  </article>
</BaseLayout>
