---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL;
const postUrl = (slug) => `${base}${slug}/`;
const categoryName = (category) => typeof category === 'string' ? category : category.name;
const latest = posts[0];
const recent = posts.slice(1, 7);
const topics = Array.from(new Set(posts.flatMap((post) => post.data.categories.map(categoryName)))).slice(0, 6);
const date = (value) => value.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout title="Yonatan Kra — Family, Code, Run" description="Software engineering articles by Yonatan Kra about testing, performance, JavaScript, AI and architecture.">
  {latest && (
    <section class="home-hero">
      <div class="hero-copy">
        <div class="eyebrow">Latest article</div>
        <h1><a href={postUrl(latest.data.slug)}>{latest.data.title}</a></h1>
        {(latest.data.excerpt || latest.data.description) && <p class="hero-excerpt">{latest.data.excerpt ?? latest.data.description}</p>}
        <div class="chip-row">
          {latest.data.categories.slice(0, 3).map((category) => <span class="chip">{categoryName(category)}</span>)}
        </div>
        <div class="post-meta"><time datetime={latest.data.published.toISOString()}>{date(latest.data.published)}</time><span>•</span><span>{latest.data.author}</span></div>
        <a class="button-link" href={postUrl(latest.data.slug)}>Read article →</a>
      </div>
      <a class="hero-media" href={postUrl(latest.data.slug)} aria-label={`Read ${latest.data.title}`}>
        {latest.data.featuredImage ? <img src={latest.data.featuredImage} alt="" /> : <div class="media-placeholder">YK</div>}
      </a>
    </section>
  )}

  {recent.length > 0 && (
    <section class="home-section">
      <div class="section-heading"><h2>Recent articles</h2><span class="muted">More from the archive</span></div>
      <div class="article-grid">
        {recent.map((post) => (
          <article class="article-card">
            <a class="card-media" href={postUrl(post.data.slug)}>
              {post.data.featuredImage ? <img src={post.data.featuredImage} alt="" /> : <div class="media-placeholder">YK</div>}
            </a>
            <div class="card-body">
              <div class="chip-row">{post.data.categories.slice(0, 2).map((category) => <span class="chip">{categoryName(category)}</span>)}</div>
              <h3><a href={postUrl(post.data.slug)}>{post.data.title}</a></h3>
              {(post.data.excerpt || post.data.description) && <p>{post.data.excerpt ?? post.data.description}</p>}
              <div class="post-meta"><time datetime={post.data.published.toISOString()}>{date(post.data.published)}</time></div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {topics.length > 0 && (
    <section class="topics-section">
      <div class="section-heading"><h2>Browse by topic</h2></div>
      <div class="topics-row">
        {topics.map((topic) => <div class="topic"><span class="topic-icon">⌘</span><strong>{topic}</strong></div>)}
      </div>
    </section>
  )}

  <style>
    .home-hero { width: min(var(--page), calc(100% - 40px)); margin: 0 auto; padding: 58px 0 50px; display: grid; grid-template-columns: .82fr 1.18fr; align-items: center; gap: 70px; }
    .hero-copy h1 { margin: 12px 0 14px; max-width: 600px; font-size: clamp(2.25rem, 4.1vw, 4rem); line-height: 1.02; letter-spacing: -.055em; }
    .hero-excerpt { max-width: 560px; margin: 0 0 18px; color: #475569; font-size: 1.08rem; line-height: 1.7; }
    .chip-row { display: flex; gap: 7px; flex-wrap: wrap; margin: 14px 0; }
    .post-meta { display: flex; align-items: center; gap: 8px; margin: 14px 0 18px; color: var(--muted); font-size: .82rem; }
    .hero-media { overflow: hidden; border-radius: 12px; aspect-ratio: 16 / 9; background: #eaf0f8; box-shadow: 0 10px 32px rgba(15,23,42,.08); }
    .hero-media img, .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s ease; }
    .hero-media:hover img, .card-media:hover img { transform: scale(1.015); }
    .media-placeholder { height: 100%; min-height: 180px; display: grid; place-items: center; background: linear-gradient(135deg,#dbeafe,#f8fafc); color: #3b82f6; font-weight: 900; font-size: 3rem; }
    .home-section { width: min(var(--page), calc(100% - 40px)); margin: 0 auto; padding: 12px 0 54px; }
    .section-heading { margin-bottom: 18px; display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
    .section-heading h2 { margin: 0; font-size: 1.15rem; letter-spacing: -.02em; }
    .article-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; }
    .article-card { overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: #fff; transition: transform .2s ease, box-shadow .2s ease; }
    .article-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15,23,42,.07); }
    .card-media { display: block; aspect-ratio: 16 / 8.5; overflow: hidden; background: #eef2f7; }
    .card-body { padding: 16px 18px 17px; }
    .card-body .chip-row { margin: 0 0 10px; }
    .card-body h3 { margin: 0 0 9px; font-size: 1.03rem; line-height: 1.28; letter-spacing: -.025em; }
    .card-body p { margin: 0; color: #526175; font-size: .85rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .card-body .post-meta { margin: 14px 0 0; }
    .topics-section { margin-top: 8px; padding: 34px max(20px, calc((100vw - var(--page)) / 2)); background: #f8fbff; border-top: 1px solid #edf2f7; border-bottom: 1px solid #edf2f7; }
    .topics-row { display: grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); gap: 0; }
    .topic { min-height: 62px; display: flex; align-items: center; gap: 12px; padding: 8px 18px 8px 0; border-right: 1px solid var(--line); }
    .topic:last-child { border-right: 0; }
    .topic-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 9px; color: var(--blue); background: #fff; border: 1px solid #dbeafe; }
    .topic strong { font-size: .88rem; }
    @media (max-width: 900px) {
      .home-hero { grid-template-columns: 1fr; gap: 28px; padding-top: 42px; }
      .hero-media { order: -1; }
      .article-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 620px) {
      .home-hero, .home-section { width: calc(100% - 28px); }
      .home-hero { padding: 26px 0 38px; }
      .hero-copy h1 { font-size: 2.35rem; }
      .article-grid { grid-template-columns: 1fr; }
      .topics-section { padding-inline: 14px; }
      .topics-row { grid-template-columns: repeat(2,minmax(0,1fr)); }
      .topic { border-right: 0; }
    }
  </style>
</BaseLayout>
