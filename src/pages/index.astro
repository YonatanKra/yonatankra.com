---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { normalizeCategory } from '../utils/category';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL;
const postUrl = (slug) => `${base}${slug}/`;
const categoryUrl = (path) => `${base}category/${path}/`;
const tagSlug = (tag) => tag.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const tagUrl = (tag) => `${base}tag/${tagSlug(tag)}/`;
const categoryName = (category) => typeof category === 'string' ? category : category.name;
const latest = posts[0];
const recent = posts.slice(1, 7);
const date = (value) => value.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const categoryCounts = new Map();
for (const post of posts) {
  for (const category of post.data.categories) {
    const normalized = normalizeCategory(category);
    const current = categoryCounts.get(normalized.path) ?? { name: normalized.name, path: normalized.path, count: 0 };
    current.count += 1;
    categoryCounts.set(normalized.path, current);
  }
}
const categories = [...categoryCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const tagCounts = new Map();
for (const post of posts) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts].map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const maxTagCount = Math.max(1, ...tags.map((tag) => tag.count));
---
<BaseLayout title="Yonatan Kra — Family, Code, Run" description="Software engineering articles by Yonatan Kra about testing, performance, JavaScript, AI and architecture.">
  {latest && (
    <section class="home-hero">
      <div class="hero-copy">
        <div class="eyebrow">Latest article</div>
        <h1><a href={postUrl(latest.data.slug)}>{latest.data.title}</a></h1>
        {(latest.data.excerpt || latest.data.description) && <p class="hero-excerpt">{latest.data.excerpt ?? latest.data.description}</p>}
        <div class="chip-row">
          {latest.data.categories.slice(0, 3).map((category) => {
            const normalized = normalizeCategory(category);
            return <a class="chip" href={categoryUrl(normalized.path)}>{normalized.name}</a>;
          })}
        </div>
        <div class="post-meta"><time datetime={latest.data.published.toISOString()}>{date(latest.data.published)}</time><span>•</span><span>{latest.data.author}</span></div>
        <a class="button-link" href={postUrl(latest.data.slug)}>Read article →</a>
      </div>
      <a class="hero-media" href={postUrl(latest.data.slug)} aria-label={`Read ${latest.data.title}`}>
        {latest.data.featuredImage ? <img src={latest.data.featuredImage} alt="" /> : <div class="media-placeholder">YK</div>}
      </a>
    </section>
  )}

  {recent.length > 0 && (
    <section class="home-section">
      <div class="section-heading"><h2>Recent articles</h2><span class="muted">More from the archive</span></div>
      <div class="article-grid">
        {recent.map((post) => (
          <article class="article-card">
            <a class="card-media" href={postUrl(post.data.slug)}>
              {post.data.featuredImage ? <img src={post.data.featuredImage} alt="" /> : <div class="media-placeholder">YK</div>}
            </a>
            <div class="card-body">
              <div class="chip-row">{post.data.categories.slice(0, 2).map((category) => {
                const normalized = normalizeCategory(category);
                return <a class="chip" href={categoryUrl(normalized.path)}>{normalized.name}</a>;
              })}</div>
              <h3><a href={postUrl(post.data.slug)}>{post.data.title}</a></h3>
              {(post.data.excerpt || post.data.description) && <p>{post.data.excerpt ?? post.data.description}</p>}
              <div class="post-meta"><time datetime={post.data.published.toISOString()}>{date(post.data.published)}</time></div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {(categories.length > 0 || tags.length > 0) && (
    <section class="topics-section">
      <div class="section-heading topics-heading">
        <div><div class="eyebrow">Explore the archive</div><h2>Browse by topic</h2></div>
      </div>
      <div class="taxonomy-grid">
        <section class="taxonomy-card" aria-labelledby="categories-title">
          <div class="taxonomy-card-heading"><span class="taxonomy-icon">▣</span><h3 id="categories-title">Categories</h3></div>
          <div class="category-list">
            {categories.slice(0, 10).map((category) => (
              <a class="category-row" href={categoryUrl(category.path)}>
                <span>{category.name}</span><span class="count">{category.count}</span>
              </a>
            ))}
          </div>
          {categories.length > 10 && <a class="taxonomy-more" href={`${base}categories/`}>View all {categories.length} categories →</a>}
        </section>

        <section class="taxonomy-card" aria-labelledby="tags-title">
          <div class="taxonomy-card-heading"><span class="taxonomy-icon">#</span><h3 id="tags-title">Popular tags</h3></div>
          {tags.length > 0 ? (
            <div class="tag-cloud">
              {tags.slice(0, 24).map((tag) => {
                const weight = 0.8 + (tag.count / maxTagCount) * 0.45;
                return <a class="tag-chip" style={`--tag-weight:${weight}`} href={tagUrl(tag.name)}><span>{tag.name}</span><small>{tag.count}</small></a>;
              })}
            </div>
          ) : <p class="muted">No tags were assigned to these posts.</p>}
          {tags.length > 24 && <a class="taxonomy-more" href={`${base}tags/`}>View all {tags.length} tags →</a>}
        </section>
      </div>
    </section>
  )}

  <style>
    .home-hero { width: min(var(--page), calc(100% - 40px)); margin: 0 auto; padding: 58px 0 50px; display: grid; grid-template-columns: .82fr 1.18fr; align-items: center; gap: 70px; }
    .hero-copy h1 { margin: 12px 0 14px; max-width: 600px; font-size: clamp(2.25rem, 4.1vw, 4rem); line-height: 1.02; letter-spacing: -.055em; }
    .hero-excerpt { max-width: 560px; margin: 0 0 18px; color: #475569; font-size: 1.08rem; line-height: 1.7; }
    .chip-row { display: flex; gap: 7px; flex-wrap: wrap; margin: 14px 0; }
    .chip-row .chip:hover { color: #123f9d; background: #dbeafe; }
    .post-meta { display: flex; align-items: center; gap: 8px; margin: 14px 0 18px; color: var(--muted); font-size: .82rem; }
    .hero-media { overflow: hidden; border-radius: 12px; aspect-ratio: 16 / 9; background: #eaf0f8; box-shadow: 0 10px 32px rgba(15,23,42,.08); }
    .hero-media img, .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s ease; }
    .hero-media:hover img, .card-media:hover img { transform: scale(1.015); }
    .media-placeholder { height: 100%; min-height: 180px; display: grid; place-items: center; background: linear-gradient(135deg,#dbeafe,#f8fafc); color: #3b82f6; font-weight: 900; font-size: 3rem; }
    .home-section { width: min(var(--page), calc(100% - 40px)); margin: 0 auto; padding: 12px 0 54px; }
    .section-heading { margin-bottom: 18px; display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
    .section-heading h2 { margin: 0; font-size: 1.15rem; letter-spacing: -.02em; }
    .article-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; }
    .article-card { overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: #fff; transition: transform .2s ease, box-shadow .2s ease; }
    .article-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15,23,42,.07); }
    .card-media { display: block; aspect-ratio: 16 / 8.5; overflow: hidden; background: #eef2f7; }
    .card-body { padding: 16px 18px 17px; }
    .card-body .chip-row { margin: 0 0 10px; }
    .card-body h3 { margin: 0 0 9px; font-size: 1.03rem; line-height: 1.28; letter-spacing: -.025em; }
    .card-body p { margin: 0; color: #526175; font-size: .85rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .card-body .post-meta { margin: 14px 0 0; }
    .topics-section { margin-top: 8px; padding: 44px max(20px, calc((100vw - var(--page)) / 2)) 50px; background: #f8fbff; border-top: 1px solid #edf2f7; border-bottom: 1px solid #edf2f7; }
    .topics-heading { align-items: end; margin-bottom: 22px; }
    .topics-heading h2 { margin-top: 5px; font-size: 1.55rem; }
    .taxonomy-grid { display: grid; grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr); gap: 20px; align-items: start; }
    .taxonomy-card { padding: 22px; border: 1px solid #dfe7f2; border-radius: 12px; background: #fff; box-shadow: 0 3px 14px rgba(15,23,42,.035); }
    .taxonomy-card-heading { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
    .taxonomy-card-heading h3 { margin: 0; font-size: 1rem; letter-spacing: -.02em; }
    .taxonomy-icon { width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid #bfdbfe; border-radius: 9px; color: var(--blue); background: #eff6ff; font-weight: 800; }
    .category-list { display: grid; gap: 2px; }
    .category-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 8px 9px; margin-inline: -9px; border-radius: 8px; color: #334155; font-size: .88rem; }
    .category-row:hover { background: #f8fafc; color: var(--blue); }
    .count { min-width: 27px; padding: 2px 7px; border-radius: 999px; color: #64748b; background: #f1f5f9; text-align: center; font-size: .72rem; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 8px; align-content: flex-start; }
    .tag-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid #e0e7ff; border-radius: 999px; color: #35425a; background: #f7f8ff; font-size: calc(.68rem * var(--tag-weight)); font-weight: 650; line-height: 1.1; }
    .tag-chip:hover { border-color: #bfdbfe; color: var(--blue); background: #eff6ff; }
    .tag-chip small { color: #94a3b8; font-size: .7em; }
    .taxonomy-more { display: inline-block; margin-top: 16px; color: var(--blue); font-size: .76rem; font-weight: 700; }
    @media (max-width: 900px) {
      .home-hero { grid-template-columns: 1fr; gap: 28px; padding-top: 42px; }
      .hero-media { order: -1; }
      .article-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
      .taxonomy-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 620px) {
      .home-hero, .home-section { width: calc(100% - 28px); }
      .home-hero { padding: 26px 0 38px; }
      .hero-copy h1 { font-size: 2.35rem; }
      .article-grid { grid-template-columns: 1fr; }
      .topics-section { padding-inline: 14px; }
      .topics-heading { display: block; }
      .taxonomy-card { padding: 18px; }
    }
  </style>
</BaseLayout>
